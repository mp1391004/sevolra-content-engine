          "layout_ok": {
            "type": "boolean"
          },
          "face_visible": {
            "type": "boolean"
          },
          "text_ok": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "product_orientation_ok": {
            "type": "boolean"
          },
          "product_scale_ok": {
            "type": "boolean"
          },
          "text_placement_ok": {
            "type": "boolean"
